# Required for web research with either model provider
TAVILY_API_KEY=your_tavily_api_key_here

# Default: all model calls use OpenAI
MODEL_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# To use Anthropic for every model call instead, change MODEL_PROVIDER to
# anthropic, add your key below, and remove OPENAI_API_KEY if you do not have one.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional per-role overrides: SCOPE_MODEL, RESEARCH_MODEL, SUPERVISOR_MODEL,
# SUMMARIZE_MODEL, COMPRESS_MODEL, WRITER_MODEL (provider:model-id).

# Optional LangSmith tracing and evaluation. Add a real key and set true to enable.
# LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=deep_research_from_scratch
